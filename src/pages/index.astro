---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import { getPermalink } from '~/utils/permalinks';
import favIconSvg from '~/assets/favicons/favicon.svg';

// The home page uses the default title from `metadata.title.default` in config.yaml.
const metadata = {
  title: METADATA?.title?.default,
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. The FAQs widget adds
// FAQPage when its `schema` prop is set.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

// All texts below are placeholders (marked "[doplnit]") to be replaced with real content.
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Zlínský kraj"
    actions={[
      {
        variant: 'primary',
        text: 'Rezervovat pobyt',
        href: '#cta',
        icon: 'tabler:calendar',
      },
      { text: 'Více informací', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Ilustrační obrázek' }}
  >
    <Fragment slot="title">
      {SITE?.name}
    </Fragment>

    <Fragment slot="subtitle">
      Apartmán k pronájmu ve Zlínském kraji. Krátký úvodní text o apartmánu a okolí [doplnit].
    </Fragment>
  </Hero>

  <!-- SocialProof Widget ************ -->

  <SocialProof
    id="proof"
    classes={{ container: '!pb-14 md:!pb-20' }}
    items={[
      { value: '–', label: 'hodnocení hostů [doplnit]', icon: 'tabler:star-filled', color: 'text-amber-400' },
      { value: '–', label: 'lůžek [doplnit]', icon: 'tabler:bed', color: 'text-primary' },
      { value: '–', label: 'm² [doplnit]', icon: 'tabler:home', color: 'text-accent' },
    ]}
  />

  <!-- QuickStart Widget ************* -->

  <QuickStart
    id="quick-start"
    classes={{ icon: 'bg-primary' }}
    tagline="Příjezd"
    title="Adresa apartmánu [doplnit]"
    subtitle="Krátký popis, jak se k apartmánu dostat [doplnit]."
    commands={['Ulice 123, 760 01 Zlín [doplnit]']}
    items={[
      {
        title: 'Autem',
        description: 'Parkování a příjezd autem [doplnit].',
        icon: 'tabler:car',
      },
      {
        title: 'Veřejnou dopravou',
        description: 'Nejbližší zastávka a spojení [doplnit].',
        icon: 'tabler:bus',
      },
      {
        title: 'Check-in a check-out',
        description: 'Časy příjezdu a odjezdu [doplnit].',
        icon: 'tabler:key',
      },
    ]}
  />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Vybavení"
    title="Co v apartmánu najdete"
    subtitle="Přehled vybavení apartmánu [doplnit]."
    items={[
      { title: 'Ložnice', description: 'Popis [doplnit].', icon: 'tabler:bed' },
      { title: 'Kuchyň', description: 'Popis [doplnit].', icon: 'tabler:tools-kitchen-2' },
      { title: 'Koupelna', description: 'Popis [doplnit].', icon: 'tabler:bath' },
      { title: 'Wi-Fi', description: 'Popis [doplnit].', icon: 'tabler:wifi' },
      { title: 'Parkování', description: 'Popis [doplnit].', icon: 'tabler:parking' },
      { title: 'Okolí', description: 'Popis [doplnit].', icon: 'tabler:trees' },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="O apartmánu"
    title="Nadpis sekce [doplnit]"
    items={[
      { title: 'Bod 1 [doplnit]', description: 'Popis [doplnit].' },
      { title: 'Bod 2 [doplnit]', description: 'Popis [doplnit].' },
      { title: 'Bod 3 [doplnit]', description: 'Popis [doplnit].' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Ilustrační obrázek',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight sm:text-3xl mb-2">Podnadpis [doplnit]</h3>
      Úvodní text sekce [doplnit].
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      { title: 'Bod 1 [doplnit]', description: 'Popis [doplnit].' },
      { title: 'Bod 2 [doplnit]', description: 'Popis [doplnit].' },
      { title: 'Bod 3 [doplnit]', description: 'Popis [doplnit].' },
      { title: 'Bod 4 [doplnit]', description: 'Popis [doplnit].' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616674282942-2835e62d612e?auto=format&fit=crop&w=1600&q=80',
      alt: 'Ilustrační obrázek',
    }}
  >
    <Fragment slot="content">Text sekce [doplnit].</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      { title: 'Bod 1 [doplnit]', description: 'Popis [doplnit].' },
      { title: 'Bod 2 [doplnit]', description: 'Popis [doplnit].' },
      { title: 'Bod 3 [doplnit]', description: 'Popis [doplnit].' },
      { title: 'Bod 4 [doplnit]', description: 'Popis [doplnit].' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Ilustrační obrázek',
    }}
  >
    <Fragment slot="content">Text sekce [doplnit].</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Jak probíhá rezervace"
    items={[
      {
        title: 'Krok 1: <span class="font-medium">Vyberte termín</span>',
        description: 'Popis [doplnit].',
        icon: 'tabler:calendar',
      },
      {
        title: 'Krok 2: <span class="font-medium">Pošlete poptávku</span>',
        description: 'Popis [doplnit].',
        icon: 'tabler:send',
      },
      {
        title: 'Krok 3: <span class="font-medium">Potvrzení</span>',
        description: 'Popis [doplnit].',
        icon: 'tabler:mail-check',
      },
      {
        title: 'Hotovo!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Ilustrační obrázek',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="V okolí"
    subtitle="Tipy na výlety a místa v okolí [doplnit]."
    tagline="Okolí"
    items={[
      { title: 'Místo 1 [doplnit]', description: 'Popis [doplnit].', icon: 'tabler:map-pin' },
      { title: 'Místo 2 [doplnit]', description: 'Popis [doplnit].', icon: 'tabler:map-pin' },
      { title: 'Místo 3 [doplnit]', description: 'Popis [doplnit].', icon: 'tabler:map-pin' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-primary/5"></div>
    </Fragment>
  </Features2>

  <!-- Timeline Widget **************** -->

  <Timeline
    id="story"
    layout="alternate"
    tagline="Pobyt"
    title="Průběh pobytu"
    subtitle="Co hosty čeká od příjezdu po odjezd [doplnit]."
    items={[
      { title: 'Příjezd [doplnit]', description: 'Popis [doplnit].', icon: 'tabler:door-enter' },
      { title: 'Během pobytu [doplnit]', description: 'Popis [doplnit].', icon: 'tabler:sun' },
      { title: 'Odjezd [doplnit]', description: 'Popis [doplnit].', icon: 'tabler:door-exit', highlight: true },
    ]}
  />

  <!-- Note Widget ******************* -->

  <Note title="Poznámka:" description="Krátké sdělení pro hosty [doplnit]" />

  <!-- FAQs Widget ******************* -->

  <!-- Add the `schema` prop (FAQPage structured data) once the answers are real. -->
  <FAQs
    id="faqs"
    title="Časté dotazy"
    subtitle="Odpovědi na otázky, které hosté kladou nejčastěji [doplnit]."
    tagline="FAQ"
    items={[
      { title: 'Otázka 1 [doplnit]', description: 'Odpověď [doplnit].' },
      { title: 'Otázka 2 [doplnit]', description: 'Odpověď [doplnit].' },
      { title: 'Otázka 3 [doplnit]', description: 'Odpověď [doplnit].' },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    id="stats"
    stats={[
      { title: 'Údaj 1 [doplnit]', amount: '–' },
      { title: 'Údaj 2 [doplnit]', amount: '–' },
      { title: 'Údaj 3 [doplnit]', amount: '–' },
      { title: 'Údaj 4 [doplnit]', amount: '–' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    id="cta"
    actions={[
      {
        variant: 'primary',
        text: 'Kontaktovat',
        href: getPermalink('/contact'),
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Rezervujte si pobyt</Fragment>

    <Fragment slot="subtitle">Text výzvy k rezervaci [doplnit].</Fragment>
  </CallToAction>
</Layout>
