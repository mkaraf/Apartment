---
import Layout from '~/layouts/PageLayout.astro';

import HeroBanner from '~/components/widgets/HeroBanner.astro';
import Showcase from '~/components/widgets/Showcase.astro';
import Gallery from '~/components/widgets/Gallery.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

// The home page uses the default title from `metadata.title.default` in config.yaml.
const metadata = {
  title: METADATA?.title?.default,
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. The FAQs widget adds
// FAQPage when its `schema` prop is set.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

// All texts below are placeholders (marked "[doplnit]") to be replaced with real content.
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Úvod ************************** -->

  <HeroBanner
    id="uvod"
    tagline="Komfortní ubytování"
    actions={[{ variant: 'primary', text: 'Rezervovat termín', href: '#rezervace', icon: 'tabler:arrow-right' }]}
    image={{ src: '~/assets/images/apartman/obyvak.jpg', alt: 'Obývací pokoj apartmánu [doplnit]' }}
  >
    <Fragment slot="title">Moderní apartmán<br />v klidné lokalitě</Fragment>
    <Fragment slot="subtitle">
      Nabízíme k pronájmu útulný a plně vybavený apartmán, který je ideální pro jednotlivce, páry nebo menší rodiny.
      [doplnit]
    </Fragment>
  </HeroBanner>

  <!-- O apartmánu: fotky + vybavení *** -->

  <Showcase
    id="apartman"
    tagline="Vybavení apartmánu"
    images={[
      { src: '~/assets/images/apartman/loznice.jpg', alt: 'Ložnice s manželskou postelí' },
      { src: '~/assets/images/apartman/obyvak-detail.jpg', alt: 'Obývací prostor' },
      { src: '~/assets/images/apartman/kuchyn.jpg', alt: 'Kuchyňský kout' },
      { src: '~/assets/images/apartman/koupelna.jpg', alt: 'Koupelna' },
    ]}
    items={[
      { title: '1 ložnice', description: '(manželská postel)', icon: 'tabler:bed' },
      { title: 'Obývací prostor', description: 's TV', icon: 'tabler:sofa' },
      { title: 'Kuchyňský kout', description: '(lednice, varná deska, mikrovlnka)', icon: 'tabler:tools-kitchen-2' },
      { title: 'Wi-Fi', description: 'zdarma', icon: 'tabler:wifi' },
      { title: 'Koupelna', description: '(sprchový kout, WC)', icon: 'tabler:bath' },
      { title: 'Parkování', description: 'v blízkosti', icon: 'tabler:parking' },
    ]}
    note={{
      title: 'Výborná lokalita',
      description:
        'V blízkosti najdete obchody, restaurace i zastávky MHD. Centrum města je snadno dostupné. [doplnit]',
      icon: 'tabler:map-pin',
    }}
  />

  <!-- Vlna ************************** -->

  <div class="text-accent -mb-px" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="block h-12 w-full md:h-20">
      <path fill="currentColor" d="M0 40 C 240 0, 480 0, 720 30 S 1200 80, 1440 20 L1440 80 L0 80 Z"></path>
    </svg>
  </div>

  <!-- Fotogalerie ******************* -->

  <Gallery
    id="fotogalerie"
    tagline="Fotogalerie"
    title="Prohlédněte si apartmán"
    images={[
      { src: '~/assets/images/apartman/obyvak.jpg', alt: 'Obývací pokoj' },
      { src: '~/assets/images/apartman/loznice.jpg', alt: 'Ložnice' },
      { src: '~/assets/images/apartman/obyvak-detail.jpg', alt: 'Obývací prostor' },
      { src: '~/assets/images/apartman/kuchyn.jpg', alt: 'Kuchyňský kout' },
      { src: '~/assets/images/apartman/koupelna.jpg', alt: 'Koupelna' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-accent"></div>
    </Fragment>
  </Gallery>

  <!-- Lokalita ********************** -->

  <Features
    id="lokalita"
    tagline="Lokalita"
    title="Kde apartmán najdete"
    subtitle="Krátký popis, jak se k apartmánu dostat [doplnit]."
    columns={2}
    items={[
      { title: 'Adresa', description: 'Ulice 123, 760 01 Zlín [doplnit]', icon: 'tabler:map-pin' },
      { title: 'Autem', description: 'Parkování a příjezd autem [doplnit].', icon: 'tabler:car' },
      { title: 'Veřejnou dopravou', description: 'Nejbližší zastávka a spojení [doplnit].', icon: 'tabler:bus' },
      { title: 'Check-in a check-out', description: 'Časy příjezdu a odjezdu [doplnit].', icon: 'tabler:key' },
    ]}
  />

  <!-- Rezervace ********************* -->

  <Steps
    id="rezervace"
    title="Jak probíhá rezervace"
    items={[
      {
        title: 'Krok 1: <span class="font-medium">Vyberte termín</span>',
        description: 'Popis [doplnit].',
        icon: 'tabler:calendar',
      },
      {
        title: 'Krok 2: <span class="font-medium">Pošlete poptávku</span>',
        description: 'Popis [doplnit].',
        icon: 'tabler:send',
      },
      {
        title: 'Krok 3: <span class="font-medium">Potvrzení</span>',
        description: 'Popis [doplnit].',
        icon: 'tabler:mail-check',
      },
      { title: 'Hotovo!', icon: 'tabler:check' },
    ]}
    image={{ src: '~/assets/images/apartman/loznice.jpg', alt: 'Ložnice apartmánu' }}
  />

  <!-- FAQs ************************** -->

  <!-- Add the `schema` prop (FAQPage structured data) once the answers are real. -->
  <FAQs
    id="faqs"
    title="Časté dotazy"
    subtitle="Odpovědi na otázky, které hosté kladou nejčastěji [doplnit]."
    tagline="FAQ"
    items={[
      { title: 'Otázka 1 [doplnit]', description: 'Odpověď [doplnit].' },
      { title: 'Otázka 2 [doplnit]', description: 'Odpověď [doplnit].' },
      { title: 'Otázka 3 [doplnit]', description: 'Odpověď [doplnit].' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-accent"></div>
    </Fragment>
  </FAQs>

  <!-- CallToAction ****************** -->

  <CallToAction
    id="cta"
    actions={[{ variant: 'primary', text: 'Kontaktovat', href: '#kontakt', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">Rezervujte si pobyt</Fragment>
    <Fragment slot="subtitle">Text výzvy k rezervaci [doplnit].</Fragment>
  </CallToAction>

  <!-- Kontakt *********************** -->

  <Features2
    id="kontakt"
    tagline="Kontakt"
    title="Kontakt"
    subtitle="Text sekce [doplnit]."
    items={[
      { title: 'Telefon', description: '+420 000 000 000 [doplnit]', icon: 'tabler:phone' },
      { title: 'E-mail', description: 'email@moje-domena.cz [doplnit]', icon: 'tabler:mail' },
      { title: 'Adresa', description: 'Ulice 123, 760 01 Zlín [doplnit]', icon: 'tabler:map-pin' },
    ]}
  />
</Layout>
