---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

import SunHero from '~/components/widgets/SunHero.astro';
import SplitList from '~/components/widgets/SplitList.astro';
import PhotoMosaic from '~/components/widgets/PhotoMosaic.astro';
import BookingSection from '~/components/widgets/BookingSection.astro';
import FaqList from '~/components/widgets/FaqList.astro';
import BookBar from '~/components/widgets/BookBar.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

// The home page uses the default title from `metadata.title.default` in config.yaml.
const metadata = {
  title: METADATA?.title?.default,
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

// All texts below are placeholders (marked "[doplnit]") to be replaced with real content.
const contactEmail = 'email@moje-domena.cz [doplnit]';
const contacts = [
  { label: 'Telefon', value: '+420 000 000 000 [doplnit]', icon: 'tabler:phone' },
  { label: 'E-mail', value: contactEmail, icon: 'tabler:mail' },
  { label: 'Adresa', value: 'Ulice 123, 760 01 Zlín [doplnit]', icon: 'tabler:map-pin' },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <SunHero
    id="uvod"
    titleLines={['Moderní apartmán', 'v klidné lokalitě']}
    subtitle="Útulný a plně vybavený apartmán ve Zlínském kraji pro jednotlivce, páry i menší rodiny. [doplnit]"
    image={{ src: '~/assets/images/apartman/obyvak.jpg', alt: 'Obývací pokoj se sedačkou a jídelním stolem' }}
    primary={{ text: 'Vybrat termín', href: '#rezervace' }}
    secondary={{ text: 'Prohlédnout fotky', href: '#fotogalerie' }}
  />

  <SplitList
    id="apartman"
    title="Vše, co na pár dní potřebujete"
    text="Krátký popis apartmánu: velikost, patro, výhled, pro koho se hodí. [doplnit]"
    items={[
      { title: '1 ložnice', description: 'manželská postel', icon: 'tabler:bed' },
      { title: 'Obývací prostor', description: 's TV', icon: 'tabler:sofa' },
      { title: 'Kuchyňský kout', description: 'lednice, varná deska, mikrovlnka', icon: 'tabler:tools-kitchen-2' },
      { title: 'Koupelna', description: 'sprchový kout, WC', icon: 'tabler:bath' },
      { title: 'Wi-Fi', description: 'zdarma', icon: 'tabler:wifi' },
      { title: 'Parkování', description: 'v blízkosti', icon: 'tabler:parking' },
    ]}
    note={{
      title: 'Výborná lokalita',
      description: 'V blízkosti najdete obchody, restaurace i zastávky MHD. Centrum je snadno dostupné. [doplnit]',
      icon: 'tabler:map-pin',
    }}
  />

  <PhotoMosaic
    id="fotogalerie"
    title="Prohlédněte si apartmán"
    subtitle="Kliknutím fotku zvětšíte."
    images={[
      { src: '~/assets/images/apartman/obyvak.jpg', alt: 'Obývací pokoj' },
      { src: '~/assets/images/apartman/loznice.jpg', alt: 'Ložnice s manželskou postelí' },
      { src: '~/assets/images/apartman/kuchyn.jpg', alt: 'Kuchyňský kout' },
      { src: '~/assets/images/apartman/obyvak-detail.jpg', alt: 'Obývací prostor' },
      { src: '~/assets/images/apartman/koupelna.jpg', alt: 'Koupelna' },
    ]}
  />

  <BookingSection
    id="rezervace"
    title="Vyberte termín pobytu"
    steps={[
      'Vyberte v kalendáři příjezd a odjezd.',
      'Vyplňte kontakt a pošlete nezávaznou poptávku.',
      'Termín vám potvrdíme e-mailem do [doplnit] hodin.',
    ]}
    note="Poptávka je nezávazná. Cenu a pokyny k platbě pošleme v potvrzení. [doplnit]"
    fallbackContact={contactEmail}
  />

  <SplitList
    id="lokalita"
    title="Kde apartmán najdete"
    text="Krátký popis, jak se k apartmánu dostat. [doplnit]"
    items={[
      { title: 'Adresa', description: 'Ulice 123, 760 01 Zlín [doplnit]', icon: 'tabler:map-pin' },
      { title: 'Autem', description: 'Parkování a příjezd autem [doplnit]', icon: 'tabler:car' },
      { title: 'Veřejnou dopravou', description: 'Nejbližší zastávka a spojení [doplnit]', icon: 'tabler:bus' },
      { title: 'Příjezd a odjezd', description: 'Check-in od [doplnit], check-out do [doplnit]', icon: 'tabler:key' },
    ]}
  />

  <!-- Add FAQPage structured data (add-structured-data skill) once the answers are real. -->
  <FaqList
    id="faqs"
    title="Časté dotazy"
    items={[
      { title: 'Otázka 1 [doplnit]', description: 'Odpověď [doplnit].' },
      { title: 'Otázka 2 [doplnit]', description: 'Odpověď [doplnit].' },
      { title: 'Otázka 3 [doplnit]', description: 'Odpověď [doplnit].' },
    ]}
  />

  <section id="kontakt" class="relative scroll-mt-[72px] bg-accent">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 md:px-6 md:py-24 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <h2 class="font-heading text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-heading md:text-5xl">
          Máte otázku?
        </h2>
        <p class="mt-5 max-w-[34rem] text-lg text-pretty text-muted">
          Zavolejte nebo napište, rádi poradíme s termínem i cestou. [doplnit]
        </p>
        <a href="#rezervace" class="btn-primary mt-8">Vybrat termín</a>
      </div>
      <ul class="grid list-none content-start gap-6 lg:col-span-7 lg:pt-3">
        {
          contacts.map(({ label, value, icon }) => (
            <li class="flex items-center gap-4 border-b border-heading/10 pb-6">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white" aria-hidden="true">
                <Icon name={icon} class="h-6 w-6 text-heading" />
              </span>
              <div>
                <p class="text-sm text-muted">{label}</p>
                <p class="font-heading text-xl font-semibold break-words text-heading md:text-2xl">{value}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BookBar text="Vybrat termín" href="#rezervace" label="Volné termíny a poptávka" />
</Layout>
