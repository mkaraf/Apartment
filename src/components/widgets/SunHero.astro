---
import Image from '~/components/common/Image.astro';
import { BOOKING } from '~/booking';
import type { ImageMetadata } from 'astro';

// Hero of the one-page site: headline on the left, the main photo on the
// right with a yellow sun rising behind it (the page's one orchestrated
// motion moment). Below the actions it shows the nearest free date, loaded
// from the shared availability request (hidden without JavaScript or data).

export interface Props {
  id?: string;
  /** Headline lines; each line rises in on its own. */
  titleLines: string[];
  subtitle?: string;
  image: { src: string | ImageMetadata; alt: string };
  primary: { text: string; href: string };
  secondary?: { text: string; href: string };
}

const { id, titleLines, subtitle, image, primary, secondary } = Astro.props;
---

<section id={id} class="relative overflow-hidden scroll-mt-[72px]">
  <div
    class="mx-auto grid max-w-7xl items-center gap-12 px-4 pt-6 pb-16 md:px-6 md:pt-10 lg:grid-cols-12 lg:pt-20 lg:pb-24"
  >
    <div class="lg:col-span-5">
      <h1
        class="font-heading text-[2.6rem] leading-[1.02] font-bold tracking-[-0.035em] text-heading sm:text-6xl lg:text-[4.25rem]"
      >
        {
          titleLines.map((line, i) => (
            <span class="anim-line block" style={`--i:${i}`}>
              {line}
            </span>
          ))
        }
      </h1>
      {
        subtitle && (
          <p class="anim-line mt-6 max-w-[34rem] text-lg text-pretty text-muted" style={`--i:${titleLines.length}`}>
            {subtitle}
          </p>
        )
      }
      <div class="anim-line mt-8 flex flex-wrap items-center gap-3" style={`--i:${titleLines.length + 1}`}>
        <a href={primary.href} class="btn-primary">{primary.text}</a>
        {
          secondary && (
            <a href={secondary.href} class="btn-tertiary text-heading underline-offset-4 hover:underline">
              {secondary.text}
            </a>
          )
        }
      </div>
      <aw-next-free data-url={BOOKING.availabilityUrl} data-min-nights={BOOKING.minNights}>
        <p class="mt-6 flex min-h-6 items-center gap-2 text-sm text-default" data-next-free-text aria-live="polite"></p>
      </aw-next-free>
    </div>

    <div class="relative lg:col-span-7">
      <div
        class="anim-sunrise pointer-events-none absolute -top-[16%] -right-[10%] aspect-square w-[52%] rounded-full bg-primary sm:-right-[6%] sm:w-[44%] lg:-top-[20%] lg:-right-[7%] lg:w-[42%]"
        aria-hidden="true"
      >
      </div>
      <div
        class="anim-photo relative overflow-hidden rounded-[1.75rem] bg-concrete shadow-[0_30px_60px_-30px_rgb(33_27_18/0.45)]"
      >
        <Image
          src={image.src}
          alt={image.alt}
          class="aspect-[4/3] w-full object-cover lg:aspect-[16/10]"
          widths={[480, 768, 976]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          width={976}
          height={610}
          layout="none"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { firstFreeArrival, formatDate, loadAvailability } from '~/utils/availability';

  class AwNextFree extends HTMLElement {
    async connectedCallback() {
      const target = this.querySelector<HTMLElement>('[data-next-free-text]');
      if (!target) return;
      const { busy, ok } = await loadAvailability(this.dataset.url ?? '');
      if (!ok) return;
      const arrival = firstFreeArrival(busy, Number(this.dataset.minNights ?? 1));
      if (!arrival) return;
      target.innerHTML = `<span class="h-2.5 w-2.5 rounded-full bg-primary ring-4 ring-primary/25" aria-hidden="true"></span>Nejbližší volný příjezd: <strong class="font-semibold text-heading">${formatDate(arrival, { weekday: 'long', day: 'numeric', month: 'long' })}</strong>`;
    }
  }
  if (!customElements.get('aw-next-free')) customElements.define('aw-next-free', AwNextFree);
</script>
