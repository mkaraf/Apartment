---
// Phone-only bar fixed to the bottom with the booking button. It slides in
// once the hero is out of view and hides again while the booking section is
// on screen, so it never covers the form it points to.

export interface Props {
  text: string;
  href: string;
  label?: string;
  heroSelector?: string;
  targetSelector?: string;
}

const { text, href, label, heroSelector = '#uvod', targetSelector = '#rezervace' } = Astro.props;
---

<aw-book-bar
  data-hero={heroSelector}
  data-target={targetSelector}
  class="fixed inset-x-0 bottom-0 z-30 translate-y-full transition-transform duration-300 ease-out-soft motion-reduce:transition-none md:hidden"
  hidden
>
  <div
    class="flex items-center justify-between gap-4 border-t border-concrete bg-page/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur"
  >
    {label && <p class="text-sm font-medium text-heading">{label}</p>}
    <a href={href} class="btn-primary shrink-0 px-5! py-2.5!">{text}</a>
  </div>
</aw-book-bar>

<script>
  class AwBookBar extends HTMLElement {
    private observer?: IntersectionObserver;

    connectedCallback() {
      const hero = document.querySelector(this.dataset.hero ?? '');
      const target = document.querySelector(this.dataset.target ?? '');
      if (!hero || !target) return;
      const visible = new Map<Element, boolean>([
        [hero, true],
        [target, false],
      ]);
      this.hidden = false;
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => visible.set(entry.target, entry.isIntersecting));
        const show = !visible.get(hero) && !visible.get(target);
        this.classList.toggle('translate-y-full', !show);
        this.inert = !show;
      });
      this.observer.observe(hero);
      this.observer.observe(target);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }
  if (!customElements.get('aw-book-bar')) customElements.define('aw-book-bar', AwBookBar);
</script>
