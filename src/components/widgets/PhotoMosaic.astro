---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import type { ImageMetadata } from 'astro';

// Photo mosaic on white with a lightbox on the native <dialog>. The first photo is the
// large tile. Photos are uncovered as they scroll in (CSS scroll timeline) and
// the clicked thumbnail morphs into the lightbox (View Transitions API). Both
// are progressive: without support (or with reduced motion) the photo simply
// appears. Escape closes, arrow keys browse; without JS the tiles are inert.

export interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  images: Array<{ src: string | ImageMetadata; alt: string }>;
}

const { id, title, subtitle, images } = Astro.props;
---

<section id={id} class="relative scroll-mt-[72px] bg-page text-heading">
  <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-24">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4 md:mb-14">
      <h2 class="font-heading text-[2.75rem] leading-[1] font-normal tracking-[-0.01em] text-balance md:text-6xl">
        {title}
      </h2>
      {subtitle && <p class="max-w-md text-muted">{subtitle}</p>}
    </div>

    <aw-mosaic>
      <ul
        class="grid list-none auto-rows-[9.5rem] grid-cols-2 gap-3 sm:auto-rows-[13rem] md:gap-4 lg:h-[36rem] lg:auto-rows-auto lg:grid-cols-4 lg:grid-rows-2"
      >
        {
          images.map(({ src, alt }, index) => (
            <li class:list={['overflow-hidden rounded-[3px]', index === 0 && 'col-span-2 row-span-2']}>
              <button
                type="button"
                class="group anim-uncover block h-full w-full cursor-zoom-in overflow-hidden rounded-[3px] bg-concrete"
                data-mosaic-open={index}
                aria-label={`Zvětšit fotku: ${alt}`}
              >
                <Image
                  src={src}
                  alt={alt}
                  class="h-full w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
                  widths={index === 0 ? [640, 1024, 1536] : [320, 640, 1200]}
                  sizes={index === 0 ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw'}
                  layout="none"
                />
              </button>
            </li>
          ))
        }
      </ul>

      <dialog
        class="m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 text-white backdrop:bg-[rgb(33_27_18/0.92)] open:grid open:place-items-center"
        aria-label="Prohlížeč fotek"
      >
        <figure class="flex max-h-full max-w-full flex-col items-center gap-3 px-4 py-16">
          <img data-mosaic-img class="max-h-[78dvh] w-auto max-w-full rounded-[3px] object-contain" alt="" />
          <figcaption class="flex items-center gap-3 text-sm text-white/85">
            <span data-mosaic-count class="tabular-nums"></span>
            <span data-mosaic-caption></span>
          </figcaption>
        </figure>
        <button
          type="button"
          data-mosaic-close
          class="absolute top-3 right-3 grid h-12 w-12 place-items-center rounded-full bg-white/10 hover:bg-white/20"
          aria-label="Zavřít"
        >
          <Icon name="tabler:x" class="h-6 w-6" />
        </button>
        <button
          type="button"
          data-mosaic-prev
          class="absolute top-1/2 left-2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 hover:bg-white/20 md:left-6"
          aria-label="Předchozí fotka"
        >
          <Icon name="tabler:chevron-left" class="h-6 w-6" />
        </button>
        <button
          type="button"
          data-mosaic-next
          class="absolute top-1/2 right-2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 hover:bg-white/20 md:right-6"
          aria-label="Další fotka"
        >
          <Icon name="tabler:chevron-right" class="h-6 w-6" />
        </button>
      </dialog>
    </aw-mosaic>
  </div>
</section>

<script>
  const NAME = 'lightbox-photo';

  class AwMosaic extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector('dialog');
      if (!dialog) return;
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-mosaic-open]')];
      const img = dialog.querySelector<HTMLImageElement>('[data-mosaic-img]')!;
      const caption = dialog.querySelector<HTMLElement>('[data-mosaic-caption]')!;
      const count = dialog.querySelector<HTMLElement>('[data-mosaic-count]')!;
      let current = 0;

      const thumb = (index: number) => buttons[index]?.querySelector('img');
      const morph = (update: () => void | Promise<void>) => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!document.startViewTransition || reduced) return void update();
        return document.startViewTransition(update).finished;
      };

      const show = async (index: number) => {
        current = (index + buttons.length) % buttons.length;
        const source = thumb(current);
        if (!source) return;
        // The largest candidate of the responsive image, never upscaled past 1.6×.
        const candidates = (source.srcset || '').split(',').map((c) => c.trim().split(' ')[0]);
        img.src = candidates.filter(Boolean).pop() || source.currentSrc || source.src;
        img.alt = source.alt;
        caption.textContent = source.alt;
        count.textContent = `${current + 1} / ${buttons.length}`;
        await img.decode().catch(() => undefined);
        img.style.maxWidth = `min(100%, ${Math.round(img.naturalWidth * 1.6)}px)`;
      };

      const open = async (index: number) => {
        const source = thumb(index);
        if (source) source.style.viewTransitionName = NAME;
        await morph(async () => {
          if (source) source.style.viewTransitionName = '';
          await show(index);
          img.style.viewTransitionName = NAME;
          dialog.showModal();
        });
        img.style.viewTransitionName = '';
      };

      const close = async () => {
        const target = thumb(current);
        img.style.viewTransitionName = NAME;
        await morph(() => {
          img.style.viewTransitionName = '';
          if (target) target.style.viewTransitionName = NAME;
          dialog.close();
        });
        if (target) target.style.viewTransitionName = '';
        buttons[current]?.focus();
      };

      buttons.forEach((button, index) => button.addEventListener('click', () => open(index)));
      dialog.querySelector('[data-mosaic-close]')?.addEventListener('click', close);
      dialog.querySelector('[data-mosaic-prev]')?.addEventListener('click', () => show(current - 1));
      dialog.querySelector('[data-mosaic-next]')?.addEventListener('click', () => show(current + 1));
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        close();
      });
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(current - 1);
        if (event.key === 'ArrowRight') show(current + 1);
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) close();
      });
    }
  }
  if (!customElements.get('aw-mosaic')) customElements.define('aw-mosaic', AwMosaic);
</script>
