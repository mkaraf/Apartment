---
// Thin bar above the header. Not rendered by default: pass it to PageLayout's
// `announcement` slot, e.g. <Announcement slot="announcement" text="Volné termíny na léto" />.
export interface Props {
  badge?: string;
  text?: string;
  href?: string;
}

const { badge = '', text = '', href = '' } = Astro.props;
---

<div
  class="text-sm bg-slate-900 text-slate-300 hidden lg:flex gap-1 overflow-hidden px-3 py-2 relative text-ellipsis whitespace-nowrap"
>
  {
    badge && (
      <span class="bg-white/20 text-slate-100 font-semibold px-1 py-0.5 text-xs mr-0.5 rtl:mr-0 rtl:ml-0.5 inline-block">
        {badge}
      </span>
    )
  }
  {
    text &&
      (href ? (
        <a href={href} class="text-slate-300 hover:underline font-medium" set:html={text} />
      ) : (
        <span class="text-slate-300 font-medium" set:html={text} />
      ))
  }
</div>
