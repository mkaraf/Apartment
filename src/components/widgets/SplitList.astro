---
import { Icon } from 'astro-icon/components';

// Split section: heading, short text and an optional highlighted note on the
// left, a plain two-column list on the right (amenities, how to get there…;
// a list, not cards: every item has the same weight).

interface Item {
  title: string;
  description?: string;
  icon: string;
}

export interface Props {
  id?: string;
  title: string;
  text?: string;
  items: Item[];
  note?: Item;
}

const { id, title, text, items, note } = Astro.props;
---

<section id={id} class="relative scroll-mt-[72px]">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 md:px-6 md:py-24 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <h2
        class="font-heading text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-balance text-heading md:text-5xl"
      >
        {title}
      </h2>
      {text && <p class="mt-5 max-w-[36rem] text-lg text-pretty text-muted">{text}</p>}
      {
        note && (
          <div class="mt-8 flex gap-4 rounded-2xl bg-accent p-5">
            <Icon name={note.icon} class="mt-0.5 h-6 w-6 shrink-0 text-ochre" aria-hidden="true" />
            <div>
              <h3 class="font-semibold text-heading">{note.title}</h3>
              {note.description && <p class="mt-1 text-default">{note.description}</p>}
            </div>
          </div>
        )
      }
    </div>

    <ul class="grid list-none content-start gap-x-10 sm:grid-cols-2 lg:col-span-7 lg:pt-3">
      {
        items.map(({ title: itemTitle, description, icon }) => (
          <li class="flex items-start gap-4 border-t border-concrete py-5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-accent" aria-hidden="true">
              <Icon name={icon} class="h-6 w-6 text-heading" />
            </span>
            <div>
              <h3 class="font-heading text-lg font-semibold text-heading">{itemTitle}</h3>
              {description && <p class="text-muted">{description}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
