---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import type { Hero as Props } from '~/types';

// Full-width hero: the photo fills the section and a light gradient on the
// left keeps the text readable. On phones the photo sits under the text.

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  actions = [],
  image,
  id,
} = Astro.props;

const imageProps = typeof image === 'object' && image ? image : undefined;
---

<section class="relative not-prose overflow-hidden bg-white scroll-mt-[72px]" {...id ? { id } : {}}>
  {
    imageProps && (
      <div class="relative h-64 sm:h-80 lg:absolute lg:inset-0 lg:h-auto">
        <Image
          class="h-full w-full object-cover object-right"
          widths={[640, 1024, 1536, 2048]}
          sizes="100vw"
          width={1536}
          height={680}
          layout="cover"
          loading="eager"
          fetchpriority="high"
          format="webp"
          {...imageProps}
        />
        <div
          class="absolute inset-0 hidden lg:block bg-linear-to-r from-white via-white/80 via-30% to-transparent to-60%"
          aria-hidden="true"
        />
      </div>
    )
  }

  <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-28">
    <div class="max-w-xl">
      {
        tagline && (
          <p class="mb-4 text-xs md:text-sm font-semibold uppercase tracking-[0.3em] text-link" set:html={tagline} />
        )
      }
      {
        title && (
          <h1
            class="mb-6 text-4xl md:text-5xl lg:text-6xl font-semibold leading-tight tracking-tight font-heading text-heading"
            set:html={title}
          />
        )
      }
      {subtitle && <p class="mb-8 text-lg md:text-xl text-muted" set:html={subtitle} />}
      {
        Array.isArray(actions) && actions.length > 0 && (
          <div class="flex flex-col sm:flex-row gap-4">
            {actions.map((action) => (
              <Button {...action} class="w-full sm:w-auto" />
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
