---
// Font families are provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro): Inter for text
// (`--font-inter`), Bricolage Grotesque for headings (`--font-bricolage`).
//
// Palette "sunny flat": warm white paper, warm near-black ink, yellow sun as
// the only loud colour (large fills, never text on white), ochre for small
// accent text and links (5.5:1 on white), cream for the booking panel and
// concrete for quiet surfaces (busy days, dividers). Light mode only.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-bricolage);

    --aw-color-primary: rgb(245 197 24); /* #F5C518 sun */
    --aw-color-secondary: rgb(232 177 0); /* #E8B100 deeper sun, button hover */
    --aw-color-accent: rgb(255 246 214); /* #FFF6D6 cream */
    --aw-color-ochre: rgb(138 98 0); /* #8A6200 ochre, accent text on white */
    --aw-color-concrete: rgb(236 232 224); /* #ECE8E0 concrete */

    --aw-color-text-heading: rgb(33 27 18); /* #211B12 ink */
    --aw-color-link: rgb(138 98 0);
    --aw-color-text-default: rgb(51 45 36);
    --aw-color-text-muted: rgb(51 45 36 / 74%);
    --aw-color-bg-page: rgb(255 254 250); /* #FFFEFA paper */

    ::selection {
      background-color: rgb(245 197 24 / 40%);
    }
  }
</style>
