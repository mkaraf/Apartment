---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
//
// Palette: warm yellow (primary), deeper yellow (secondary, used for button
// hover) and soft cream (accent, used for highlighted boxes and section
// backgrounds) on a white page. Buttons on yellow use dark text. Light mode only.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(245 197 24); /* #F5C518 warm yellow */
    --aw-color-secondary: rgb(232 177 0); /* #E8B100 deeper yellow */
    --aw-color-accent: rgb(255 246 214); /* #FFF6D6 cream */

    --aw-color-text-heading: rgb(38 38 38);
    --aw-color-link: rgb(201 154 0); /* darker yellow, readable on white */
    --aw-color-text-default: rgb(55 55 55);
    --aw-color-text-muted: rgb(55 55 55 / 72%);
    --aw-color-bg-page: rgb(255 255 255);

    ::selection {
      background-color: rgb(245 197 24 / 30%);
    }
  }
</style>
