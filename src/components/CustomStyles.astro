---
// Font families are provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro): Inter for text
// (`--font-inter`), Gloock for headings and the wordmark (`--font-gloock`).
//
// Palette "white and sunflower": white page, warm near-black ink for text and
// buttons, sunflower yellow (the "girassol") as the loud colour on large
// surfaces (booking panel, contact) and yellow buttons on the hero photo;
// never as text on white. Ochre for small accent text and links (5.5:1 on
// white), light yellow for quiet highlights, warm grey for busy days and
// dividers. Light mode only.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-gloock);
    --aw-font-heading: var(--font-gloock);

    --aw-color-primary: rgb(245 197 24); /* #F5C518 sunflower */
    --aw-color-secondary: rgb(232 177 0); /* #E8B100 deeper sunflower, hover */
    --aw-color-accent: rgb(255 246 214); /* #FFF6D6 light yellow highlight */
    --aw-color-ochre: rgb(138 98 0); /* #8A6200 ochre, accent text on white */
    --aw-color-concrete: rgb(236 233 226); /* #ECE9E2 warm grey */
    --aw-color-ink: rgb(28 26 23); /* #1C1A17 buttons, photo scrim */

    --aw-color-text-heading: rgb(28 26 23);
    --aw-color-link: rgb(138 98 0);
    --aw-color-text-default: rgb(46 43 39);
    --aw-color-text-muted: rgb(46 43 39 / 74%);
    --aw-color-bg-page: rgb(255 255 255);

    ::selection {
      background-color: rgb(245 197 24 / 45%);
    }
  }
</style>
