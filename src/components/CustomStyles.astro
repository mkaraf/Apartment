---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
//
// Palette: warm terracotta (primary), darker clay (secondary, used for button
// hover) and sage green (accent) on a warm off-white page. Light mode only.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(160 82 45); /* #A0522D terracotta */
    --aw-color-secondary: rgb(127 63 34); /* #7F3F22 clay */
    --aw-color-accent: rgb(95 122 90); /* #5F7A5A sage */

    --aw-color-text-heading: rgb(36 28 24);
    --aw-color-text-default: rgb(46 38 33);
    --aw-color-text-muted: rgb(46 38 33 / 70%);
    --aw-color-bg-page: rgb(253 250 246); /* #FDFAF6 */

    ::selection {
      background-color: rgb(160 82 45 / 20%);
    }
  }
</style>
