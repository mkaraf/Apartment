---
import { SITE } from 'astrowind:config';

// Text logo built from `site.name` in config.yaml. To use an image instead,
// add src/assets/images/logo.svg and replace the <span> below with:
//
//   import { Image } from 'astro:assets';
//   import logo from '~/assets/images/logo.svg';
//   <Image src={logo} alt={SITE?.name} class="h-8 w-auto" loading="eager" />
---

<span data-logo class="flex items-center gap-2.5 self-center ml-2 rtl:ml-0 rtl:mr-2 whitespace-nowrap">
  <span class="h-2.5 w-2.5 rounded-full bg-primary" aria-hidden="true"></span>
  <span class="font-heading text-xl md:text-2xl uppercase text-heading">{SITE?.name}</span>
</span>
