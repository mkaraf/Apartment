---
import { SITE } from 'astrowind:config';

// Text logo built from `site.name` in config.yaml. To use an image instead,
// add src/assets/images/logo.svg and replace the <span> below with:
//
//   import { Image } from 'astro:assets';
//   import logo from '~/assets/images/logo.svg';
//   <Image src={logo} alt={SITE?.name} class="h-8 w-auto" loading="eager" />
---

<span class="flex items-center gap-3 self-center ml-2 rtl:ml-0 rtl:mr-2 whitespace-nowrap">
  <span class="h-6 w-6 rounded-full bg-primary ring-4 ring-primary/25" aria-hidden="true"></span>
  <span class="font-heading text-lg md:text-xl font-bold tracking-tight text-heading">{SITE?.name}</span>
</span>
